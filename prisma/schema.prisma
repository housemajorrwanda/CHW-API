generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url = env("DATABASE_URL")
}

model User {
  id                 String         @id @default(uuid())
  email              String?         @unique
  password           String
  fullNames          String
  phoneNumber        String         @unique
  district           String
  sector             String
  cell               String
  village            String
  NID                String?
  gender             String?
  birthdate          DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  otp                String?
  otpExpiresAt       DateTime? 
  photo              String         @default("https://img.freepik.com/premium-vector/user-profile-icon-flat-style-member-avatar-vector-illustration-isolated-background-human-permission-sign-business-concept_157943-15752.jpg")

  // Only keep direct relations to Student and Staff
  student            Student?
  staff              Staff?
  notification       Notification[]
  userRoles          UserRole[]
  faqOnSlides        FAQOnSlide[]
}



enum RoleType {
  ADMIN
  TRAINER
  SUPERVISOR
  TRAINEE
  DEVELOPER
  ADMINISTRATOR
  STAFF
}

model UserRole {
  id          String  @id @default(uuid())
  userId      String
  name        RoleType
  user        User    @relation(fields: [userId], references: [id])
}

model Notification {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  message     String
  type        NotificationType @default(info)
  isRead      Boolean  @default(false)
  actionUrl   String?  @db.VarChar(500)

  entityType  String?  @db.VarChar(50)
  entityId    String?
  metadata    Json?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum NotificationType {
  info
  success
  warning
  error
}

model Course {
  id               String      @id @default(uuid())
  creatorId        String       
  title            String 
  coverIcon        String
  description      String?
  isPublished      Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  // Relations
  staff            Staff        @relation(fields: [creatorId], references: [id])
  sections         Section[]
  intro            CourseIntro?
  progresses       CourseProgress[]
}

model Section {
  id               String      @id @default(uuid())
  courseId         String
  title            String
  description      String?
  totalChapter     Int         @default(0)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  // Relations
  course           Course      @relation(fields: [courseId], references: [id])
  chapters         Chapter[]
  preTests         PreTest[]
}

model Chapter {
  id               String      @id @default(uuid())
  sectionId        String
  title            String
  description      String?
  totalSlide       Int         @default(0)
  chapterNumber    Int
  activityAt       Int?
  lessonDuration   Int         @default(5)
  isPublished      Boolean     @default(true)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  // Relations
  section          Section     @relation(fields: [sectionId], references: [id])
  slides           Slide[]
  midTest          MidTest?
  finalTest        FinalTest?
  chapterProgresses ChapterProgress[]
  documents        DocumentOnSlide[]
}

model Slide {
  id               String      @id @default(uuid())
  chapterId        String
  note             String?
  description      String?
  slideNumber      Int
  file             String?      
  isPublished      Boolean     @default(true)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  // Relations
  chapter          Chapter     @relation(fields: [chapterId], references: [id])
  faqs             FAQOnSlide[]
  studentSlides    StudentOnSlide[]
  slideProgress    SlideProgress[]
}

model CourseIntro {
  id               String      @id @default(uuid())
  courseId         String     @unique
  title            String
  summary          String
  bannerImage      String?
  thumbnail        String
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  // Relations
  course           Course      @relation(fields: [courseId], references: [id])
}

model PreTest   {
  id               String      @id @default(uuid())
  sectionId         String
  isPublished      Boolean     @default(true)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  questionToBeAnswered  Int    @default(1)
  marksToPass      Int    @default(0)
  description      String?
  // Relations
  section          Section     @relation(fields: [sectionId], references: [id])
  questionnaires   Questionnaire[]
  attempts         AttempTest[]
}

model  MidTest {
  id               String      @id @default(uuid())
  chapterId        String     @unique
  createdAt         DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  questionToBeAnswered  Int    @default(1)
  marksToPass      Int    @default(0)
  description      String?
  // Relations
  chapter          Chapter     @relation(fields: [chapterId], references: [id])
  questionnaires   Questionnaire[]
  attempts         AttempTest[]
}

model FinalTest {
  id               String      @id @default(uuid())
  chapterId        String     @unique
  isPublished      Boolean     @default(true)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  questionToBeAnswered  Int    @default(1)
  marksToPass      Int    @default(0)
  description      String?
  // Relations
  chapter          Chapter     @relation(fields: [chapterId], references: [id])
  questionnaires   Questionnaire[]
  attempts         AttempTest[]
}


model Questionnaire {
  id                 String      @id @default(uuid())
  question           String
  questionImage      String?
  allowMultiple      Boolean     @default(false)
  preTestId          String?
  midTestId          String?
  finalTestId        String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  // Relations
  preTest           PreTest?    @relation(fields: [preTestId], references: [id])
  midTest           MidTest?    @relation(fields: [midTestId], references: [id])
  finalTest         FinalTest?  @relation(fields: [finalTestId], references: [id])
  attemptAnswers    AttemptAnswer[]
  options           Option[]
  answers           Answer[]
}

model AttemptAnswer {
  id                 String      @id @default(uuid())
  attemptId          String
  questionnaireId    String
  selectedAnswerIds  String[]
  isCorrect          Boolean     @default(false)
  marks              Float       @default(0.0)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  // Relations
  attempt            AttempTest  @relation(fields: [attemptId], references: [id])
  questionnaire      Questionnaire @relation(fields: [questionnaireId], references: [id])
}

model Option {
  id                 String      @id @default(uuid())
  label             String
  image             String?
  createdAt         DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  // Relations
  questionnaireId   String
  questionnaire     Questionnaire @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
}

model Answer {
  id                 String      @id @default(uuid())
  label             String
  image             String?
  createdAt         DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  // Relations
  questionnaireId   String
  questionnaire     Questionnaire @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
}


model AttempTest {
  id                 String      @id @default(uuid())
  studentId             String
  preTestId             String?
  midTestId             String?
  finalTestId             String?
  tryCount            Int       @default(1)
  marks               Float     @default(0.0)
  isCompleted            Boolean   @default(false)
  createdAt         DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  // Relations
  student           Student     @relation(fields: [studentId], references: [id])
  preTest           PreTest?    @relation(fields: [preTestId], references: [id])
  midTest           MidTest?    @relation(fields: [midTestId], references: [id])
  finalTest         FinalTest?  @relation(fields: [finalTestId], references: [id])
  attemptAnswers    AttemptAnswer[]
}

model CourseProgress {
  id                 String      @id @default(uuid())
  studentId             String
  courseId             String
  progress            Float     @default(0.0)
  isCompleted          Boolean  @default(false)
  createdAt         DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  // Relations
  student           Student     @relation(fields: [studentId], references: [id])
  course            Course      @relation(fields: [courseId], references: [id])
}

model ChapterProgress {
  id                 String      @id @default(uuid())
  studentId             String
  chapterId             String
  progress            Float     @default(0.0)
  isCompleted          Boolean  @default(false)
  createdAt         DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  // Relations
  student           Student     @relation(fields: [studentId], references: [id])
  chapter           Chapter     @relation(fields: [chapterId], references: [id])
}

model SlideProgress {
  id                 String      @id @default(uuid())
  studentId             String
  slideId             String
  isCompleted          Boolean  @default(false)
  createdAt         DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  // Relations
  student           Student     @relation(fields: [studentId], references: [id])
  slide            Slide      @relation(fields: [slideId], references: [id])
}

model DocumentOnSlide {
  id                 String      @id @default(uuid())
  fileName             String
  file                 String
  chapterId             String
  createdAt         DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  // Relations
  chapter           Chapter     @relation(fields: [chapterId], references: [id])
}

model FAQOnSlide {
  id                 String      @id @default(uuid())
  userId          String
  slideId             String
  message            String    
  isPublished        Boolean     @default(true)
  createdAt         DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  // Relations
  user           User     @relation(fields: [userId], references: [id])
  slide             Slide       @relation(fields: [slideId], references: [id])
}

model StudentOnSlide {
  id                 String      @id @default(uuid())
  studentId             String
  slideId             String
  progress            Float     @default(0.0)
  createdAt         DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  // Relations
  student           Student     @relation(fields: [studentId], references: [id])
  slide             Slide       @relation(fields: [slideId], references: [id])
}

model Student {
  id                 String      @id @default(uuid())
  userId             String      @unique
  role               RoleType    @default(TRAINEE)

  // Relations
  user               User        @relation(fields: [userId], references: [id])
  attempts           AttempTest[]
  courseProgresses   CourseProgress[]
  chapterProgresses  ChapterProgress[]
  studentOnSlides    StudentOnSlide[]
  slideProgress    SlideProgress[]
}

model Staff {
  id                 String      @id @default(uuid())
  userId             String      @unique
  role               RoleType    @default(STAFF)

  // Relations
  user               User        @relation(fields: [userId], references: [id])
  courses            Course[]
}